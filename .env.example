# ===== 数据库（MySQL 8.4，替换成你的 root 密码）=====
DATABASE_URL=mysql+asyncmy://root:你的密码@127.0.0.1:3306/guanchao

# ===== Redis（本期可选，限流后续再用）=====
REDIS_URL=redis://127.0.0.1:6379/0

# ===== JWT =====
JWT_SECRET=please-change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_SECONDS=7200
REFRESH_TOKEN_EXPIRE_SECONDS=2592000

# ===== 微信小程序（不填则进入 mock 登录模式）=====
WECHAT_APPID=
WECHAT_SECRET=

# ===== 通义千问 =====
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen-plus
QWEN_VL_MODEL=qwen-vl-max

# ===== 潮汐数据（和风天气，不填则降级为演示数据）=====
TIDE_API_HOST=https://nq3jpjg4yq.re.qweatherapi.com
TIDE_LOCATION_ID=P2717
TIDE_API_KEY=

# ===== 高德地图（Web 服务 Key，用于地点搜索 + AOI 边界）=====
AMAP_KEY=

# ===== 管理后台（审核宝藏点位投稿；留空则 /admin 相关接口全部拒绝）=====
# 浏览器打开 <域名>/admin，在页面里填入这里配置的令牌即可审核。请用足够长的随机串。
ADMIN_TOKEN=

# ===== 腾讯云 COS（图片存储）=====
# 四项都填齐才启用；缺任何一项就回退成服务器本地磁盘（功能不受影响，只是不走 CDN）。
# 桶权限建议「公有读」：图片 URL 直接给小程序加载，不经服务器转发。
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=

# ===== 静态资源同步（tools/sync_static.py 用，可不填，用脚本内置默认值）=====
# 作用：把前端 assets/ 同步到服务器的静态资源目录。小程序图片走「仓库一份源图 +
# 服务器服务一份」，packOptions.ignore 把 assets/ 排除出主包，代码里引用的是 CDN 地址。
SYNC_SSH_HOST=Administrator@<你的服务器 IP>
SYNC_STATIC_LOCAL=../前端/assets
SYNC_STATIC_REMOTE=C:/guanchao/data/uploads/static/assets
